#!/usr/bin/env bash
set -euo pipefail

# sync-agents — Thin CLI wrapper around agent-hub's unified TypeScript
# plan/check/apply engine (src/cli.ts).
#
# Hub directory resolution order:
#   1. --dir <path>
#   2. $AGENTS_DIR environment variable
#   3. <XDG config base>/agent-hub/config.json ("agentsDir"); the base is $XDG_CONFIG_HOME when
#      it is absolute, else $HOME/.config
#   4. $HOME/.agents

resolve_script_path() {
  local p="$1"
  while [[ -L "$p" ]]; do
    local dir
    dir="$(cd -P "$(dirname "$p")" && pwd)"
    local target
    target="$(readlink "$p")"
    case "$target" in
      /*) p="$target" ;;
      *)  p="$dir/$target" ;;
    esac
  done
  local dir
  dir="$(cd -P "$(dirname "$p")" && pwd)"
  printf '%s/%s\n' "$dir" "$(basename "$p")"
}

SCRIPT_REAL="$(resolve_script_path "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "$SCRIPT_REAL")"
INSTALL_ROOT="$(cd -P "$SCRIPT_DIR/.." && pwd)"
CLI_SCRIPT="$INSTALL_ROOT/src/cli.ts"

# Bun reads .env, bunfig.toml and tsconfig.json/jsconfig.json (also from parent directories) from
# the working directory by default: a checkout could then redirect AGENTS_DIR / XDG_*, preload
# code, or remap modules so its own file runs instead. Every bun call here ignores all three.
BUN_ISOLATED=(--config=/dev/null --no-env-file --tsconfig-override=/dev/null)

expand_tilde() {
  local p="$1"
  case "$p" in
    "~")   printf '%s\n' "$HOME" ;;
    "~/"*) printf '%s/%s\n' "$HOME" "${p:2}" ;;
    *)     printf '%s\n' "$p" ;;
  esac
}

# Lexically resolve "." and ".." in an absolute path, as Node's path.normalize does, so this
# canonicalizer agrees with the engine's canonicalizeHubPath (which normalizes before resolving
# the deepest existing ancestor). Without it, a ".." under a nonexistent directory survived here
# but not in the engine, and install.sh's hub-overlap guard compared the wrong paths.
lexical_normalize() {
  local IFS=/
  local -a parts out=()
  read -r -a parts <<< "$1"
  local part
  for part in "${parts[@]}"; do
    case "$part" in
      "" | .) ;;
      ..) if [[ ${#out[@]} -gt 0 ]]; then unset 'out[${#out[@]}-1]'; fi ;;
      *) out+=("$part") ;;
    esac
  done
  if [[ ${#out[@]} -eq 0 ]]; then printf '/\n'; else printf '/%s\n' "${out[*]}"; fi
}

# ---- Output: JSON Lines by default (each line names its schema), prose with --human ----
# The same contract as the engine (src/output.ts, schemas/); this wrapper emits only the
# agent_hub.help, agent_hub.print_dir and agent_hub.error message types itself.
HUMAN=0
for a in "$@"; do
  case "$a" in --human|--humanize) HUMAN=1 ;; esac
done
RUN_ID="$(od -An -tx1 -N8 /dev/urandom | tr -d ' \n')"
SCHEMA_IDS='"agent_hub.op","agent_hub.conflict","agent_hub.recovery","agent_hub.summary","agent_hub.error","agent_hub.help","agent_hub.print_dir","agent_hub.schema"'

# Escape a string for a JSON string literal (backslash, quote, and the control characters a
# message or path can contain here: newline, tab, carriage return).
json_str() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\t'/\\t}"
  s="${s//$'\r'/\\r}"
  # Any other control character is escaped as \u00XX, so no input can break the line.
  if [[ "$s" == *[$'\x01'-$'\x1f']* ]]; then
    local out="" ch i
    for ((i = 0; i < ${#s}; i++)); do
      ch="${s:i:1}"
      if [[ "$ch" == [$'\x01'-$'\x1f'] ]]; then
        out+="$(printf '\\u%04x' "'$ch")"
      else
        out+="$ch"
      fi
    done
    s="$out"
  fi
  printf '"%s"' "$s"
}

# emit_line <stdout|stderr> <schema id> <kind> <message> [extra JSON fields, comma-prefixed]
emit_line() {
  local stream="$1" id="$2" kind="$3" message="$4" extra="${5:-}"
  local line
  if [[ "$HUMAN" -eq 1 ]]; then
    line="$message"
  else
    line="{\"_schema\":{\"id\":\"$id\",\"version\":\"1.0.0\"},\"kind\":\"$kind\",\"run_id\":\"$RUN_ID\",\"message\":$(json_str "$message")$extra}"
  fi
  if [[ "$stream" == "stdout" ]]; then printf '%s\n' "$line"; else printf '%s\n' "$line" >&2; fi
}

# emit_error <code> <message>
emit_error() {
  emit_line stderr agent_hub.error error "$2" ",\"code\":$(json_str "$1")"
}

canonicalize_path() {
  local raw="$1"
  local p
  p="$(expand_tilde "$raw")"
  if [[ "$p" == *$'\n'* ]]; then
    emit_error usage "${0##*/}: refusing a path that contains a newline: $raw"
    return 1
  fi
  # Resolve a relative path against the physical cwd, as the engine's process.cwd() does;
  # the logical $PWD keeps symlink names, so a ".." would climb a different directory.
  case "$p" in
    /*) ;;
    *)  p="$(pwd -P)/$p" ;;
  esac
  p="$(lexical_normalize "$p")"

  # Normalize /./ and trailing slashes while resolving the deepest existing ancestor physically.
  local tail=()
  local cursor="$p"
  while true; do
    if [[ -e "$cursor" ]]; then
      local real_base
      if [[ -d "$cursor" ]]; then
        real_base="$(cd -P "$cursor" && pwd)"
      else
        real_base="$(cd -P "$(dirname "$cursor")" && pwd)/$(basename "$cursor")"
      fi
      local out="$real_base"
      local idx=$(( ${#tail[@]} - 1 ))
      while [[ "$idx" -ge 0 ]]; do
        if [[ "$out" == "/" ]]; then
          out="/${tail[$idx]}"
        else
          out="$out/${tail[$idx]}"
        fi
        idx=$((idx - 1))
      done
      if [[ "$out" != "/" ]]; then
        out="${out%/}"
      fi
      printf '%s\n' "$out"
      return 0
    fi
    local parent
    parent="$(dirname "$cursor")"
    if [[ "$parent" == "$cursor" ]]; then
      printf '%s\n' "$p"
      return 0
    fi
    local base
    base="$(basename "$cursor")"
    if [[ "$base" != "." && -n "$base" ]]; then
      tail+=("$base")
    fi
    cursor="$parent"
  done
}

read_config_agents_dir() {
  # A relative XDG_CONFIG_HOME is ignored, as the XDG spec requires (and as the engine does).
  local xdg_base="$HOME/.config"
  if [[ "${XDG_CONFIG_HOME:-}" == /* ]]; then xdg_base="$XDG_CONFIG_HOME"; fi
  local cfg="$xdg_base/agent-hub/config.json"
  [[ -f "$cfg" ]] || return 0
  if command -v bun >/dev/null 2>&1; then
    bun "${BUN_ISOLATED[@]}" -e '
      import { readFileSync } from "node:fs";
      const cfg = JSON.parse(readFileSync(process.argv[1], "utf8"));
      if (typeof cfg.agentsDir === "string" && cfg.agentsDir.length > 0) {
        process.stdout.write(cfg.agentsDir);
      }
    ' "$cfg" 2>/dev/null || true
  elif ! command -v python3 >/dev/null 2>&1; then
    # Guessing ~/.agents here would let install.sh's hub-overlap guard check the wrong hub.
    emit_error config "sync-agents: $cfg exists but neither bun nor python3 is available to read it; set AGENTS_DIR to the hub, or install Bun or python3"
    return 1
  else
    python3 -c '
import json, sys
try:
    d = json.load(open(sys.argv[1]))
    v = d.get("agentsDir", "")
    if isinstance(v, str) and v:
        sys.stdout.write(v)
except Exception:
    pass
' "$cfg" 2>/dev/null || true
  fi
}

usage() {
  cat <<'EOF'
Usage: sync-agents [OPTIONS]

Install skills into your canonical hub directory (default ~/.agents/) and sync
AGENTS.md, skills/, and mcp/ configs across local AI coding agents.

Options:
      --dir <path>                 Override hub directory (default: $AGENTS_DIR, then
                                   ~/.config/agent-hub/config.json "agentsDir", then ~/.agents)
      --skill <src>                Install a skill from a directory, git repo URL,
                                   .bundle, .zip/.skill, or tarball into <hub>/skills/<name>,
                                   then sync installed agents (repeatable)
      --skill-only                 Install --skill source(s) into <hub>/skills/ without syncing
                                   agent targets
      --force-skill                Allow --skill to replace differing canonical skill(s) ONLY
                                   (never authorizes MCP or symlink replacement)
  -f, --force                      Allow replacing differing canonical skills, unmanaged/modified
                                   symlinks, and differing/disabled unmanaged MCP entries
  -n, --dry-run                    Print planned changes without modifying final destinations,
                                   ownership state, journals, or locks
      --check                      Verify symlinks, MCP configs, ownership ledger, and pending
                                   recovery are clean; exit 1 on any drift, conflict, or pending work
      --adopt                      Adopt unmanaged identical symlinks, MCP entries, or strictly
                                   equivalent files/directories into verified v2 ownership
      --disown-legacy <agent>:<name>
                                   Retire an unverified legacy v1 .mcp-managed.json claim without
                                   modifying the target config (requires canonical server removed)
      --explain                    Print observed state, intended state, ownership basis, reason,
                                   and next step for each object without modifying disk
      --targets <csv>              Restrict sync/check/dry-run/explain to specific target(s):
                                   antigravity, claude, codex, cursor, opencode, or one
                                   domain of one, e.g. opencode:mcp or cursor:links
                                   (excluded targets are never pruned). Replaces the
                                   config.json "disabledTargets" list for this run
      --print-dir                  Print the canonical resolved hub directory and exit
      --human, --humanize          Print prose instead of JSON Lines (the default output: one
                                   JSON object per line on stdout and stderr, each naming its
                                   schema in "_schema")
      --schema                     Print every output message schema as JSON Lines and exit
  -h, --help                       Show this help
EOF
}

# Handle --help and --print-dir without requiring Bun.
CLI_AGENTS_DIR=""
PRINT_DIR=0
SHOW_HELP=0
ARGS=("$@")
i=0
while [[ "$i" -lt "${#ARGS[@]}" ]]; do
  arg="${ARGS[$i]}"
  case "$arg" in
    -h|--help)
      SHOW_HELP=1
      ;;
    --print-dir)
      PRINT_DIR=1
      ;;
    --dir)
      if [[ $((i + 1)) -ge "${#ARGS[@]}" ]]; then
        emit_error usage "sync-agents: --dir requires a path argument"
        exit 2
      fi
      i=$((i + 1))
      CLI_AGENTS_DIR="${ARGS[$i]}"
      ;;
    --dir=*)
      CLI_AGENTS_DIR="${arg#--dir=}"
      if [[ -z "$CLI_AGENTS_DIR" ]]; then
        emit_error usage "sync-agents: --dir requires a non-empty path argument"
        exit 2
      fi
      ;;
  esac
  i=$((i + 1))
done

if [[ "$SHOW_HELP" -eq 1 ]]; then
  USAGE_TEXT="$(usage)"
  emit_line stdout agent_hub.help help "$USAGE_TEXT" ",\"command\":\"sync-agents\",\"usage\":$(json_str "$USAGE_TEXT"),\"schemas\":[$SCHEMA_IDS]"
  exit 0
fi

if [[ "$PRINT_DIR" -eq 1 ]]; then
  if [[ -n "$CLI_AGENTS_DIR" ]]; then
    RAW_DIR="$CLI_AGENTS_DIR"
  elif [[ -n "${AGENTS_DIR:-}" ]]; then
    RAW_DIR="$AGENTS_DIR"
  else
    CFG_DIR="$(read_config_agents_dir)" || exit 1
    if [[ -n "$CFG_DIR" ]]; then
      RAW_DIR="$CFG_DIR"
    else
      RAW_DIR="$HOME/.agents"
    fi
  fi
  HUB="$(canonicalize_path "$RAW_DIR")" || exit 2
  emit_line stdout agent_hub.print_dir print_dir "$HUB" ",\"hub\":$(json_str "$HUB")"
  exit 0
fi

# Upfront Bun prerequisite check before any sync work.
if ! command -v bun >/dev/null 2>&1; then
  emit_error internal "sync-agents: bun is required to run sync-agents (install from https://bun.sh)"
  exit 1
fi

if [[ ! -f "$CLI_SCRIPT" ]]; then
  emit_error internal "sync-agents: engine script not found at $CLI_SCRIPT"
  exit 1
fi

exec bun "${BUN_ISOLATED[@]}" "$CLI_SCRIPT" "$@"
