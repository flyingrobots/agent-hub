#!/usr/bin/env bash
set -euo pipefail

# sync-agents — Thin CLI wrapper around agent-hub's unified TypeScript
# plan/check/apply engine (src/cli.ts).
#
# Hub directory resolution order:
#   1. --dir <path>
#   2. $AGENTS_DIR environment variable
#   3. <XDG config base>/agent-hub/config.json ("agentsDir"); the base is $XDG_CONFIG_HOME when
#      it is absolute, else $HOME/.config
#   4. $HOME/.agents

resolve_script_path() {
  local p="$1"
  while [[ -L "$p" ]]; do
    local dir
    dir="$(cd -P "$(dirname "$p")" && pwd)"
    local target
    target="$(readlink "$p")"
    case "$target" in
      /*) p="$target" ;;
      *)  p="$dir/$target" ;;
    esac
  done
  local dir
  dir="$(cd -P "$(dirname "$p")" && pwd)"
  printf '%s/%s\n' "$dir" "$(basename "$p")"
}

SCRIPT_REAL="$(resolve_script_path "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "$SCRIPT_REAL")"
INSTALL_ROOT="$(cd -P "$SCRIPT_DIR/.." && pwd)"
CLI_SCRIPT="$INSTALL_ROOT/src/cli.ts"

expand_tilde() {
  local p="$1"
  case "$p" in
    "~")   printf '%s\n' "$HOME" ;;
    "~/"*) printf '%s/%s\n' "$HOME" "${p:2}" ;;
    *)     printf '%s\n' "$p" ;;
  esac
}

canonicalize_path() {
  local raw="$1"
  local p
  p="$(expand_tilde "$raw")"
  case "$p" in
    /*) ;;
    *)  p="$PWD/$p" ;;
  esac

  # Normalize /./ and trailing slashes while resolving the deepest existing ancestor physically.
  local tail=()
  local cursor="$p"
  while true; do
    if [[ -e "$cursor" ]]; then
      local real_base
      if [[ -d "$cursor" ]]; then
        real_base="$(cd -P "$cursor" && pwd)"
      else
        real_base="$(cd -P "$(dirname "$cursor")" && pwd)/$(basename "$cursor")"
      fi
      local out="$real_base"
      local idx=$(( ${#tail[@]} - 1 ))
      while [[ "$idx" -ge 0 ]]; do
        if [[ "$out" == "/" ]]; then
          out="/${tail[$idx]}"
        else
          out="$out/${tail[$idx]}"
        fi
        idx=$((idx - 1))
      done
      if [[ "$out" != "/" ]]; then
        out="${out%/}"
      fi
      printf '%s\n' "$out"
      return 0
    fi
    local parent
    parent="$(dirname "$cursor")"
    if [[ "$parent" == "$cursor" ]]; then
      printf '%s\n' "$p"
      return 0
    fi
    local base
    base="$(basename "$cursor")"
    if [[ "$base" != "." && -n "$base" ]]; then
      tail+=("$base")
    fi
    cursor="$parent"
  done
}

read_config_agents_dir() {
  # A relative XDG_CONFIG_HOME is ignored, as the XDG spec requires (and as the engine does).
  local xdg_base="$HOME/.config"
  if [[ "${XDG_CONFIG_HOME:-}" == /* ]]; then xdg_base="$XDG_CONFIG_HOME"; fi
  local cfg="$xdg_base/agent-hub/config.json"
  [[ -f "$cfg" ]] || return 0
  if command -v bun >/dev/null 2>&1; then
    bun -e '
      import { readFileSync } from "node:fs";
      const cfg = JSON.parse(readFileSync(process.argv[1], "utf8"));
      if (typeof cfg.agentsDir === "string" && cfg.agentsDir.length > 0) {
        process.stdout.write(cfg.agentsDir);
      }
    ' "$cfg" 2>/dev/null || true
  elif command -v python3 >/dev/null 2>&1; then
    python3 -c '
import json, sys
try:
    d = json.load(open(sys.argv[1]))
    v = d.get("agentsDir", "")
    if isinstance(v, str) and v:
        sys.stdout.write(v)
except Exception:
    pass
' "$cfg" 2>/dev/null || true
  fi
}

usage() {
  cat <<'EOF'
Usage: sync-agents [OPTIONS]

Install skills into your canonical hub directory (default ~/.agents/) and sync
AGENTS.md, skills/, and mcp/ configs across local AI coding agents.

Options:
      --dir <path>                 Override hub directory (default: $AGENTS_DIR, then
                                   ~/.config/agent-hub/config.json "agentsDir", then ~/.agents)
      --skill <src>                Install a skill from a directory, git repo URL,
                                   .bundle, .zip/.skill, or tarball into <hub>/skills/<name>,
                                   then sync installed agents (repeatable)
      --skill-only                 Install --skill source(s) into <hub>/skills/ without syncing
                                   agent targets
      --force-skill                Allow --skill to replace differing canonical skill(s) ONLY
                                   (never authorizes MCP or symlink replacement)
  -f, --force                      Allow replacing differing canonical skills, unmanaged/modified
                                   symlinks, and differing/disabled unmanaged MCP entries
  -n, --dry-run                    Print planned changes without modifying final destinations,
                                   ownership state, journals, or locks
      --check                      Verify symlinks, MCP configs, ownership ledger, and pending
                                   recovery are clean; exit 1 on any drift, conflict, or pending work
      --adopt                      Adopt unmanaged identical symlinks, MCP entries, or strictly
                                   equivalent files/directories into verified v2 ownership
      --disown-legacy <agent>:<name>
                                   Retire an unverified legacy v1 .mcp-managed.json claim without
                                   modifying the target config (requires canonical server removed)
      --explain                    Print observed state, intended state, ownership basis, reason,
                                   and next step for each object without modifying disk
      --targets <csv>              Restrict sync/check/dry-run/explain to specific target(s):
                                   antigravity, claude, codex, cursor, opencode, or one
                                   domain of one, e.g. opencode:mcp or cursor:links
                                   (excluded targets are never pruned). Replaces the
                                   config.json "disabledTargets" list for this run
      --print-dir                  Print the canonical resolved hub directory and exit
  -h, --help                       Show this help
EOF
}

# Handle --help and --print-dir without requiring Bun.
CLI_AGENTS_DIR=""
PRINT_DIR=0
SHOW_HELP=0
ARGS=("$@")
i=0
while [[ "$i" -lt "${#ARGS[@]}" ]]; do
  arg="${ARGS[$i]}"
  case "$arg" in
    -h|--help)
      SHOW_HELP=1
      ;;
    --print-dir)
      PRINT_DIR=1
      ;;
    --dir)
      if [[ $((i + 1)) -ge "${#ARGS[@]}" ]]; then
        echo "sync-agents: --dir requires a path argument" >&2
        exit 2
      fi
      i=$((i + 1))
      CLI_AGENTS_DIR="${ARGS[$i]}"
      ;;
    --dir=*)
      CLI_AGENTS_DIR="${arg#--dir=}"
      if [[ -z "$CLI_AGENTS_DIR" ]]; then
        echo "sync-agents: --dir requires a non-empty path argument" >&2
        exit 2
      fi
      ;;
  esac
  i=$((i + 1))
done

if [[ "$SHOW_HELP" -eq 1 ]]; then
  usage
  exit 0
fi

if [[ "$PRINT_DIR" -eq 1 ]]; then
  if [[ -n "$CLI_AGENTS_DIR" ]]; then
    RAW_DIR="$CLI_AGENTS_DIR"
  elif [[ -n "${AGENTS_DIR:-}" ]]; then
    RAW_DIR="$AGENTS_DIR"
  else
    CFG_DIR="$(read_config_agents_dir)"
    if [[ -n "$CFG_DIR" ]]; then
      RAW_DIR="$CFG_DIR"
    else
      RAW_DIR="$HOME/.agents"
    fi
  fi
  canonicalize_path "$RAW_DIR"
  exit 0
fi

# Upfront Bun prerequisite check before any sync work.
if ! command -v bun >/dev/null 2>&1; then
  echo "sync-agents: bun is required to run sync-agents (install from https://bun.sh)" >&2
  exit 1
fi

if [[ ! -f "$CLI_SCRIPT" ]]; then
  echo "sync-agents: engine script not found at $CLI_SCRIPT" >&2
  exit 1
fi

exec bun "$CLI_SCRIPT" "$@"
